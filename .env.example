# ============================================================================================
# Docker (v4.0): copy to .env, set MONGO_PASSWORD and SETUP_CODE, then `docker compose up -d --build`
# ============================================================================================
MONGO_PASSWORD=change-me-letters-and-digits
# MONGO_USER=ewadmin
# MONGO_DB=equity_watchlist
SETUP_CODE=change-me-one-time-code
# BIND_ADDR=127.0.0.1          # 0.0.0.0 to open the app from other devices on your network
# APP_PORT=4173
# DOMAIN=watchlist.example.com # AWS / public server with docker-compose.aws.yml (automatic HTTPS)
# MONGO_URL=mongodb+srv://...  # only when using MongoDB Atlas instead of the mongo container (no compose)

# Copy this file to .env and fill in your own key — or just export these
# in your shell before `npm start`. Never commit a real key to source control.

# Required for the financial-advisor feature (Reports > Advisor, and the
# "Ask the advisor" button in the stock detail panel). Get one at
# https://console.anthropic.com. Every call is billed to this key under
# Anthropic's usage-based pricing — see https://www.anthropic.com/pricing
# for current rates. The rest of the app (prices, news, reports, history)
# works fully without this key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model the advisor uses. Defaults to claude-sonnet-5.
# A faster/cheaper model (e.g. a Haiku model) is a reasonable choice for
# running the advisor across many stocks at once; check
# https://docs.claude.com for current model names.
ADVISOR_MODEL=claude-sonnet-5

# --- Price sources -----------------------------------------------------------
# Order in which prices are tried (first one that answers wins). Default: kite,yahoo,google
# "kite" is skipped unless KITE_MCP_ENABLED=1 and you are logged in.
# PRICE_SOURCES=kite,yahoo,google

# --- Zerodha Kite via MCP (read-only) -----------------------------------------
# On by default: log in from the Integrations tab; no API key or secret is needed. Set to 0 to switch Kite off.
# KITE_MCP_ENABLED=0
# Hosted server by default. Point at your own Kite MCP server if you self-host.
# KITE_MCP_URL=https://mcp.kite.trade/mcp

# --- Angel One / Dhan / Groww ------------------------------------------------------
# You do NOT need these: enter the same details on the Integrations tab (each broker card -> Settings), where they are
# saved in data/broker-credentials.json. Values here are only a fallback; details saved in the app win.

# --- Angel One (SmartAPI), read-only holdings -----------------------------------
# Create an app at https://smartapi.angelone.in (free) and enable TOTP for your account there.
# ANGEL_API_KEY=your_smartapi_key
# ANGEL_CLIENT_CODE=A1234567
# Optional, for one-click login. Leave out to type the PIN and 6-digit TOTP on the Integrations tab each day.
# ANGEL_PIN=1234
# ANGEL_TOTP_SECRET=BASE32SECRETFROMTHEQRCODE

# --- Dhan (DhanHQ API v2), read-only holdings --------------------------------------
# Simplest: paste a token from web.dhan.co -> My Profile -> Access DhanHQ APIs on the Integrations tab (valid 24 h),
# or put it here. Live prices for Dhan holdings need Dhan's Data API plan; without it the watchlist price is used.
# DHAN_ACCESS_TOKEN=
# DHAN_CLIENT_ID=1100000000
# Optional, to generate the token with PIN + TOTP (set up TOTP under DhanHQ Trading APIs on web.dhan.co):
# DHAN_PIN=123456
# DHAN_TOTP_SECRET=BASE32SECRET

# --- Groww (Trade API), read-only holdings -----------------------------------------
# Needs an active Trade API subscription on Groww. Either paste an access token on the Integrations tab
# (groww.in -> Trading APIs; expires 6 AM daily), put it here, or use an API key with its secret or TOTP.
# GROWW_ACCESS_TOKEN=
# GROWW_API_KEY=
# GROWW_API_SECRET=
# GROWW_TOTP_SECRET=

# --- Angel One / Dhan through an MCP server (Integrations tab -> card -> Connection: MCP server) ------------
# A hosted server URL can be typed in the app instead. A LOCAL server command can only be set here.
# DHAN_MCP_URL=https://<url from docs.dhanhq.co/mcp>
# ANGEL_MCP_URL=
# Local (stdio) server, e.g. the community https://github.com/pyalgobot/angelone-mcp (review it first):
# ANGEL_MCP_COMMAND=python -m angelone_mcp.server
# DHAN_MCP_COMMAND=

# --- INDmoney (INDstocks API, read-only) --------------------------------------
# Daily access token from indstocks.com → API Trading → Access Tokens (expires after 24 h). Usually pasted in the app instead.
# INDMONEY_ACCESS_TOKEN=

# --- Hosting (v2.8: sign-in and per-account data) ---------------------------------
# HOST=127.0.0.1                 # 0.0.0.0 only behind a load balancer
# PUBLIC_URL=https://watchlist.example.com
# TRUST_PROXY=1                  # when Caddy / nginx / an AWS load balancer terminates HTTPS
# COOKIE_SECURE=1
# SESSION_DAYS=30
# DATA_DIR=/var/lib/equity-watchlist
# SETUP_CODE=                    # optional fixed first-run code (random by default)
# ALLOW_MEMBER_ADVISOR=0

# --- US stocks tab (v3.2) ---
# SEC asks every client to identify itself: your name and email.
# SEC_USER_AGENT="Your Name your@email.com"
